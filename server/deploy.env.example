# ── Production env for the Railway deployment ──────────────────────────────────
# Copy these keys into Railway:  Project -> <service> -> Variables.
# NEVER commit real values. Any key left out uses the code default.
# PORT is auto-injected by Railway and overrides the Dockerfile ENV — don't set it.
# Full walkthrough: docs/DEPLOY_RAILWAY.md

# App
NODE_ENV=production

# Frontend (CORS) — the deployed Vercel URL, exact, no trailing slash
FRONTEND_URL=https://hi5-six.vercel.app
# Optional extra origins, comma-separated (Vercel preview domains)
# FRONTEND_ORIGINS=https://hi5-six-git-main-abc123-xyz.vercel.app

# Auth — generate with:  openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-base64-secret

# Database (Railway MySQL plugin — fill from its "Data" tab; TLS required)
DB_HOST=your-db.proxy.rlwy.net
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=railway
DB_SSL=require
# Reusing an OLDER Railway DB? Rotate its password first — the previous one is public.

# Email (password reset) — Gmail App Password
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=16-char-app-password
# GMAIL_FROM_NAME=HI5 Portal

# PDF rendering — Chromium is baked into the image; path is already bundled
PDF_CHROME_PATH=/usr/bin/chromium

# Storage — attach a Railway Volume at /data, then point these at it
UPLOAD_DIR=/data/uploads
BACKUP_DIR=/data/backups

# Database backup (mysqldump is in the image; override only if custom)
# MYSQLDUMP_PATH=mysqldump
