# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hi5_portal
DB_USER=root
DB_PASSWORD=your_password_here

# JWT
JWT_SECRET=change_this_to_a_random_secret_string
JWT_EXPIRES_IN=8h

# Server
PORT=3001
NODE_ENV=development

# Frontend (CORS) — set to the deployed frontend URL in production
FRONTEND_URL=http://localhost:5173
# Optional comma-separated extra origins, e.g. Vercel preview domains:
# FRONTEND_ORIGINS=https://hi5-six-git-main-abc123-xyz.vercel.app

# Backup
BACKUP_DIR=./backups
# Path to mysqldump.exe / mysql.exe — needed if not in system PATH
# MYSQLDUMP_PATH=C:/xampp/mysql/bin/mysqldump.exe
# MYSQL_PATH=C:/xampp/mysql/bin/mysql.exe

# AI provider for at-risk classification — 'node' (built-in regression, default)
# or 'python' (FastAPI + scikit-learn microservice in ai-service/).
AI_PROVIDER=node
AI_SERVICE_URL=http://127.0.0.1:8000

# SMTP / password-reset email
# Providers (checked in order): Resend (recommended) then Gmail SMTP.
#
# Resend — create an API key at https://resend.com/api-keys
# RESEND_API_KEY=
# RESEND_FROM is your verified sender, e.g. "HI5 Portal <noreply@yourschool.ph"
# (defaults to GMAIL_USER, or onboarding@resend.dev if unset)
# RESEND_FROM_NAME=HI5 Portal
#
# Gmail SMTP fallback (Gmail App Password):
# Google Account -> Security -> 2-Step Verification -> App passwords
# GMAIL_USER is the Gmail address that sends the mail; GMAIL_APP_PASSWORD
# is the 16-char App Password (letters, no spaces). NEVER use the raw
# account password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional display name for the From line (default: HI5 Portal)
# GMAIL_FROM_NAME=HI5 Portal
# Optional SMTP overrides (defaults: smtp.gmail.com:465, implicit TLS)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
